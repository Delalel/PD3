<Window x:Class="Konstr.FenceTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konstr"
        mc:Ignorable="d"
        Title="Забор" Height="1024" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#0D1B2A" CornerRadius="12">
        <Grid>

            <Grid x:Name="TitleBar" Height="30" VerticalAlignment="Top" Background="#0D1B2A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1325,0,0,0" Width="105">
                    <Button Content="—" Width="60" Height="20" Background="Transparent" Foreground="#E0E1DD" FontSize="16" Cursor="Hand" Click="MinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#121820"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>



                    <Button Content="✕" Width="30" Height="20" Background="Transparent" Foreground="#E0E1DD" FontSize="16" Cursor="Hand" Click="CloseButton_Click" Margin="5,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#121820"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF5F5F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Canvas>

                <TextBlock Text="Забор"
                               FontWeight="Normal"
                               FontStyle="Normal"
                               FontSize="90"
                               LineHeight="128"
                               Foreground="#E0E1DD"
                               TextAlignment="Center"
                               FontFamily="Cambria" HorizontalAlignment="Center" Height="106" VerticalAlignment="Top" Canvas.Left="600" Canvas.Top="46" />

                <Border Grid.Column="0" 
                                Width="400" 
                                Height="500" 
                                Background="#1A2736" 
                                CornerRadius="12" 
                                BorderBrush="#4A6FA5" 
                                BorderThickness="2" Canvas.Left="70" Canvas.Top="262">
                    <TextBlock Text="Чертеж" 
                                       Foreground="#8890A0" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontStyle="Italic"/>

                    <!-- <Image Source="path/to/drawing.png" /> -->
                </Border>


                <StackPanel Grid.Column="1" VerticalAlignment="Top" Canvas.Left="720" Canvas.Top="356" HorizontalAlignment="Left" Width="582">


                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="Длина" 
                                           Foreground="#E0E1DD" 
                                           FontSize="28" 
                                           FontWeight="Medium" 
                                           FontFamily="Cambria" 
                                           Width="252" 
                                           TextAlignment="Center"
                                           Margin="0,0,20,0"/>
                        <Border Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8">
                            <TextBox 
                                Height="65"
                                Width="286"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,0"
                                FontSize="18"
                                CaretBrush="White"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="Ширина" 
                                           Foreground="#E0E1DD" 
                                           FontSize="28" 
                                           FontWeight="Medium" 
                                           FontFamily="Cambria" 
                                           Width="254" 
                                           TextAlignment="Center"
                                           Margin="0,0,20,0"/>
                        <Border Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8">
                            <TextBox 
                                Height="65"
                                Width="286"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,0"
                                FontSize="18"
                                CaretBrush="White"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Количество секций" 
                                           Foreground="#E0E1DD" 
                                           FontSize="28" 
                                           FontWeight="Medium" 
                                           FontFamily="Cambria" 
                                           Width="252" 
                                           TextAlignment="Center"
                                           Margin="0,0,20,0"/>
                        <Border Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8">
                            <TextBox 
                                Height="65"
                                Width="292"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,0"
                                FontSize="18"
                                CaretBrush="White"
                                VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                </StackPanel>

                <Button 
                            Height="74"
                            Width="231"
                            Background="#415A77"
                            Foreground="#0D1B2A"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontSize="30"
                            FontWeight="SemiBold"
                            FontFamily="Cambria"
                            Cursor="Hand" Canvas.Left="608" Canvas.Top="870">
                    Назад
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="25">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A5C8A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#2A4A70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button 
                            Height="74"
                            Width="231"
                            Background="#415A77"
                            Foreground="#0D1B2A"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontSize="30"
                            FontWeight="SemiBold"
                            FontFamily="Cambria"
                            Cursor="Hand" Canvas.Left="1071" Canvas.Top="870">
                    Отправить
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="25">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A5C8A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#2A4A70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


            </Canvas>

        </Grid>
    </Border>
</Window>
